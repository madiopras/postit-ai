# ─────────────────────────────────────────────────────────────
# PostIt AI — environment template
#
#   cp .env.example .env    then fill in the values below.
#
# Every variable here is read by the code. Verify with:
#   grep -rho "process\.env\.[A-Z_0-9]*" app lib scripts proxy.ts
# ─────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────
# Must match the POSTGRES_* values below — docker-compose builds the
# same database from them. Read by lib/db.ts and drizzle.config.ts.
DATABASE_URL=postgresql://simpleai:simpleai@localhost:5432/simpleai

# Consumed by docker-compose.yml to provision the container.
POSTGRES_DB=simpleai
POSTGRES_USER=simpleai
POSTGRES_PASSWORD=simpleai

# ─── Auth ────────────────────────────────────────────────────
# Required. There is no fallback: lib/auth.ts throws if this is unset,
# so that a known default can never be used to forge an admin token.
# Generate with:  openssl rand -base64 32
JWT_SECRET=

# Required to save AI configuration from the dashboard. The provider API keys in
# the app_config table are encrypted with AES-256-GCM using this key, so losing
# it means the stored keys can no longer be read (re-enter them to recover).
# Generate with:  openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# ─── AI endpoints (fallback layer) ───────────────────────────
# Resolution order is: app_config table > these variables > built-in default.
# Anything set in the dashboard (/dashboard/config) overrides these, so they
# only need to be filled in to get a working instance before first login.
#
# One base URL serves both embedding and chat — lib/config.ts reads
# ROUTER_BASE_URL for each. Point it at any OpenAI-compatible endpoint;
# the paths appended are /embeddings and /chat/completions.
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=

# The embedding model MUST output 1536 dimensions to match the
# vector(1536) column in lib/schema.ts. Changing to a model with a
# different width requires a schema migration and a full re-embed.
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
LLM_MODEL=dios-escampur

